# Image générique pour TOUS les microservices Python (38 services)
FROM python:3.12-slim

WORKDIR /app
ARG SERVICE_DIR=services/auth-service
COPY packages/ /app/packages/
COPY ${SERVICE_DIR}/ /app/service/
RUN pip install --no-cache-dir -r /app/service/requirements.txt

ENV PYTHONPATH=/app/packages/medisuite-core:/app/packages/clinical-rules:/app/service/src
ENV MEDISUITE_ENV=docker
EXPOSE 8000
CMD ["sh", "-c", "uvicorn ${SERVICE_MODULE} --host 0.0.0.0 --port ${SERVICE_PORT:-8000}"]
