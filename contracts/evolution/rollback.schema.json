{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://medisuite.local/contracts/evolution/rollback.schema.json",
  "title": "Rollback",
  "type": "object",
  "required": [
    "id",
    "release",
    "trigger",
    "checkpoints_restored"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^RBK-[0-9]{4}$"
    },
    "release": {
      "type": "string"
    },
    "trigger": {
      "enum": [
        "error_rate",
        "latency_p95",
        "clinical_safety",
        "model_drift",
        "performance_degradation",
        "critical_alert",
        "human_decision"
      ]
    },
    "checkpoints_restored": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "smoke_passed": {
          "type": "boolean"
        },
        "evidence_id": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}