# ============ TropiRAG — Configuration d'environnement ============
# Copier vers .env puis ajuster.

# --- Mode d'inférence IA ---------------------------------------------
# deterministic : aucun modèle IA requis (défaut, fonctionne partout)
# ollama        : gateway Ollama locale (http://localhost:11434)
# vllm          : gateway OpenAI-compatible vLLM (http://localhost:8001)
TROPIRAG_INFERENCE_MODE=deterministic

# --- Endpoints des gateways ------------------------------------------
TROPIRAG_OLLAMA_URL=http://localhost:11434
TROPIRAG_VLLM_URL=http://localhost:8001

# --- Mesh multi-nœuds (V1.1 — branchement réel Ollama) ----------------
# Routage famille → nœud. Format : famille=URL,famille=URL
# Familles reconnues : speech, vision, embeddings, reranking, text
# Topologie de référence : deployment/ollama/nodes.yaml
# TROPIRAG_OLLAMA_NODES=speech=http://node1:11434,vision=http://node1:11434,embeddings=http://node1:11434,reranking=http://node1:11434,text=http://node2:11434

# --- Sécurité API ----------------------------------------------------
TROPIRAG_API_KEY=change-me-in-production

# --- Persistance -----------------------------------------------------
TROPIRAG_DB_PATH=db/tropirag.sqlite3

# --- Observabilité ---------------------------------------------------
TROPIRAG_LOG_LEVEL=INFO
TROPIRAG_LOG_FORMAT=json

# --- Juridiction clinique par défaut ---------------------------------
TROPIRAG_JURISDICTION=CI
